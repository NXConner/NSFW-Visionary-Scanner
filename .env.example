# MorphoScan Pro environment configuration
# Copy this file to .env and replace the values with your production credentials.

# Supabase project configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_SERVICE_ROLE_KEY=

# Application metadata
VITE_APP_ENV=development
VITE_APP_VERSION=0.0.0
VITE_FEATURE_FLAGS=visual_excellence,mobile_first,advanced_scanner,analytics

# Security & privacy controls
VITE_PRIVACY_CONTACT_EMAIL=
VITE_CLIENT_ENCRYPTION_SALT=

# Server-side credentials
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://morphoscan_admin:change-me@localhost:5432/morphoscan
ADMIN_SUPER_EMAIL=n8ter8@gmail.com

# Local docker-compose database defaults
POSTGRES_DB=morphoscan
POSTGRES_USER=morphoscan_admin
POSTGRES_PASSWORD=change-me
