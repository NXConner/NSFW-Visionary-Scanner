# ========================================
# MorphoScan Pro - Environment Configuration
# ========================================
# Copy this file to .env.local for local development
# Copy this file to .env for production deployment
# 
# IMPORTANT: Never commit .env or .env.local to version control!
# ========================================

# ========================================
# SUPABASE CONFIGURATION (Required)
# ========================================
# Get these from: https://app.supabase.com/project/_/settings/api
# For local development, you can use Supabase CLI (supabase start)

# Your Supabase project URL
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Your Supabase anonymous/public key (safe to expose in frontend)
VITE_SUPABASE_PUBLISHABLE_KEY=<your-supabase-anon-key>

# Your Supabase project reference ID
VITE_SUPABASE_PROJECT_ID=<your-project-ref>

# Non-Vite Supabase keys for scripts (seed/RLS checks)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ========================================
# APPLICATION METADATA (Required)
# ========================================

# Application environment: development | staging | production
VITE_APP_ENV=development

# App build flavor: sfw | nsfw | hybrid
# - sfw: Safe-for-work version (health tracking only)
# - nsfw: Adult content enabled version
# - hybrid: Both modes available with toggle
VITE_APP_VERSION=nsfw

# Distribution channel: store | direct
# - store: Google Play / App Store distribution (with fees)
# - direct: Direct download (no platform fees)
VITE_DISTRIBUTION_CHANNEL=direct

# Feature flags (comma-separated list)
# Available flags: visual_excellence, mobile_first, advanced_scanner, analytics
VITE_FEATURE_FLAGS=visual_excellence,mobile_first,advanced_scanner,analytics

# ========================================
# SECURITY & PRIVACY (Required)
# ========================================

# Contact email for support inquiries
VITE_SUPPORT_CONTACT_EMAIL=support@yourapp.com

# Contact email for privacy-related inquiries
VITE_PRIVACY_CONTACT_EMAIL=privacy@yourapp.com

# Data Protection Officer contact email
VITE_DPO_CONTACT_EMAIL=dpo@yourapp.com

# Client-side encryption salt (IMPORTANT: Use a unique value per environment)
# Generate with: openssl rand -base64 32
VITE_CLIENT_ENCRYPTION_SALT=<your-unique-encryption-salt>

# ========================================
# ADMIN CONFIGURATION
# ========================================
# Admin roles are managed via the user_roles database table
# To grant admin access, insert a row with role='super_admin' for the user
# See docs/security/rls/RLS_AUDIT_CHECKLIST.md for access control patterns

# ========================================
# STRIPE PAYMENT INTEGRATION (Optional - Required for Payments)
# ========================================
# Get these from: https://dashboard.stripe.com/apikeys

# Stripe public/publishable key (safe to expose in frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Simple tier price IDs (used by src/lib/stripe.ts for basic tier upgrades)
VITE_STRIPE_PRO_PRICE_ID=price_...
VITE_STRIPE_PREMIUM_PRICE_ID=price_...

# ========================================
# STRIPE PRICING MATRIX (Optional - Required for Full Pricing)
# ========================================
# Used by src/lib/pricing.ts for complete pricing management
# Create these in Stripe Dashboard: https://dashboard.stripe.com/products

# --- SFW (Safe-For-Work) App Store Pricing ---
VITE_STRIPE_SFW_APP_STORE_PRICE_ID=price_...
VITE_STRIPE_SFW_PRO_STORE_MONTHLY_PRICE_ID=price_...
VITE_STRIPE_SFW_PREMIUM_STORE_MONTHLY_PRICE_ID=price_...
VITE_STRIPE_SFW_PRO_STORE_YEARLY_PRICE_ID=price_...
VITE_STRIPE_SFW_PREMIUM_STORE_YEARLY_PRICE_ID=price_...
VITE_STRIPE_SFW_LIFETIME_STORE_PRICE_ID=price_...

# --- SFW Direct Distribution Pricing ---
VITE_STRIPE_SFW_APP_DIRECT_PRICE_ID=price_...
VITE_STRIPE_SFW_PRO_DIRECT_MONTHLY_PRICE_ID=price_...
VITE_STRIPE_SFW_PREMIUM_DIRECT_MONTHLY_PRICE_ID=price_...
VITE_STRIPE_SFW_PRO_DIRECT_YEARLY_PRICE_ID=price_...
VITE_STRIPE_SFW_PREMIUM_DIRECT_YEARLY_PRICE_ID=price_...
VITE_STRIPE_SFW_LIFETIME_DIRECT_PRICE_ID=price_...

# --- NSFW (Adult Content) Direct Distribution Pricing ---
VITE_STRIPE_NSFW_APP_DIRECT_PRICE_ID=price_...
VITE_STRIPE_NSFW_PRO_DIRECT_MONTHLY_PRICE_ID=price_...
VITE_STRIPE_NSFW_PREMIUM_DIRECT_MONTHLY_PRICE_ID=price_...
VITE_STRIPE_NSFW_PRO_DIRECT_YEARLY_PRICE_ID=price_...
VITE_STRIPE_NSFW_PREMIUM_DIRECT_YEARLY_PRICE_ID=price_...
VITE_STRIPE_NSFW_LIFETIME_DIRECT_PRICE_ID=price_...

# --- NSFW DLC (Downloadable Content) Pricing ---
VITE_STRIPE_NSFW_DLC_STORE_PRICE_ID=price_...
VITE_STRIPE_NSFW_DLC_DIRECT_PRICE_ID=price_...

# ========================================
# ERROR TRACKING & MONITORING (Optional)
# ========================================
# Get these from: https://sentry.io/

# Sentry DSN for error tracking (leave empty to disable)
VITE_SENTRY_DSN=

# ========================================
# SERVER-SIDE SECRETS (DO NOT SET IN .env)
# ========================================
# These should be set in your hosting platform's secrets/environment variables
# (e.g., Supabase Edge Functions Secrets, Vercel Environment Variables)
# NEVER commit these to version control or set them in .env

# Stripe secret key (server-side only)
# STRIPE_SECRET_KEY=sk_live_...

# Stripe webhook secret (server-side only)
# STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase service role key (server-side only)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Database connection URL (managed by hosting platform)
# DATABASE_URL=postgresql://...

# ========================================
# NEW REVENUE DLC FEATURES (Phase 4 - $50K-100K Revenue Potential)
# ========================================

# Premium Position Collections - Advanced pose library ($9.99/month)
VITE_STRIPE_PRICE_PREMIUM_POSITIONS_MONTHLY=price_premium_positions_monthly_999
VITE_STRIPE_PRICE_PREMIUM_POSITIONS_YEARLY=price_premium_positions_yearly_9599

# Advanced NSFW Detection Modes - Multi-model ensemble ($14.99/month)
VITE_STRIPE_PRICE_ADVANCED_NSFW_DETECTION_MONTHLY=price_advanced_nsfw_detection_monthly_1499
VITE_STRIPE_PRICE_ADVANCED_NSFW_DETECTION_YEARLY=price_advanced_nsfw_detection_yearly_14399

# Wellness Coaching AI - Personalized insights ($19.99/month)
VITE_STRIPE_PRICE_WELLNESS_COACHING_MONTHLY=price_wellness_coaching_monthly_1999
VITE_STRIPE_PRICE_WELLNESS_COACHING_YEARLY=price_wellness_coaching_yearly_19199

# Partner Sync - Collaborative tracking ($24.99/month)
VITE_STRIPE_PRICE_PARTNER_SYNC_MONTHLY=price_partner_sync_monthly_2499
VITE_STRIPE_PRICE_PARTNER_SYNC_YEARLY=price_partner_sync_yearly_23999

# Medical Export - HIPAA-compliant reports ($29.99/month)
VITE_STRIPE_PRICE_MEDICAL_EXPORT_MONTHLY=price_medical_export_monthly_2999
VITE_STRIPE_PRICE_MEDICAL_EXPORT_YEARLY=price_medical_export_yearly_28799

# Research Participation - Anonymized data contribution (Free + rewards)
# No price ID needed - rewards-based system

# ========================================
# RLS TESTING + PARTNER SYNC (Local QA)
# ========================================
# RLS check script uses these credentials (test account only)
RLS_TEST_EMAIL=
RLS_TEST_PASSWORD=

# Partner sync seed import
PARTNER_SYNC_SEED_FILE=scripts/seed/partner-sync-seed.json

# ========================================
# NOTES
# ========================================
# 1. For local development, copy this to .env.local and fill in your values
# 2. For production, set these in your hosting platform's environment settings
# 3. Use test/sandbox keys during development
# 4. Always use different encryption salts for dev/staging/production
# 5. Never commit real credentials to version control
# 6. Review the DEPLOYMENT_CHECKLIST.md before deploying to production
