# Copy to `.env` (never commit `.env`).
# This file intentionally contains NO real secrets.
#
# Notes:
# - Variables prefixed with `VITE_` are embedded into the client bundle by Vite.
#   Do NOT put private keys/secrets in `VITE_*` variables.
# - Server-only secrets should be stored in your hosting/secrets manager and/or
#   Supabase Edge Function secrets (not in the client).

##############################
# App / build configuration  #
##############################

# dev | test | staging | production | ci
VITE_APP_ENV=development

# sfw | nsfw | hybrid
VITE_APP_VERSION=nsfw

# store | direct
VITE_DISTRIBUTION_CHANNEL=direct

# Public app URL (used in emails/links)
VITE_APP_URL=http://localhost:8080

# Optional runtime flags (JSON string)
# Example: {"nsfw":true,"beta":false}
VITE_FEATURE_FLAGS={}

# Content policy selector (string). Keep this non-sensitive.
# Example values (project-defined): sfw | nsfw | hybrid
VITE_CONTENT_POLICY=nsfw

# Force service worker cleanup on next load (true/false)
VITE_FORCE_SW_CLEANUP=false

##############################
# Supabase (client/public)   #
##############################

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase "anon" key (publishable/public)
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY

# Optional (used by docs/scripts): your Supabase project ref
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

##############################
# Security (client-side)     #
##############################

# Used for client-side encryption helpers; rotate per environment.
VITE_CLIENT_ENCRYPTION_SALT=CHANGE_ME_PER_ENV

##############################
# Support / compliance       #
##############################

VITE_SUPPORT_CONTACT_EMAIL=support@yourdomain.invalid
VITE_PRIVACY_CONTACT_EMAIL=privacy@yourdomain.invalid
VITE_DPO_CONTACT_EMAIL=dpo@yourdomain.invalid

##############################
# Admin / Partner Sync       #
##############################

VITE_ADMIN_EMAIL=admin@yourdomain.invalid
VITE_ADMIN_SUPER_EMAIL=super_admin@yourdomain.invalid

# Comma-separated emails (no spaces) for additional admin accounts
VITE_ADDITIONAL_ADMINS=

# Optional partner defaults
VITE_PARTNER_EMAIL=
VITE_ADDITIONAL_PARTNERS=

# Partner Sync auto-connect pair (comma-free emails)
VITE_PARTNER_PAIR_EMAIL_1=
VITE_PARTNER_PAIR_EMAIL_2=

##############################
# Payments (client/public)   #
##############################

VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Legacy/compat pricing ids (some UI reads these directly)
VITE_STRIPE_PRO_PRICE_ID=
VITE_STRIPE_PREMIUM_PRICE_ID=
VITE_STRIPE_PRO_MONTHLY_PRICE_ID=
VITE_STRIPE_PREMIUM_MONTHLY_PRICE_ID=

# DLC package price IDs (monthly/yearly)
VITE_STRIPE_PRICE_PARTNER_SYNC_MONTHLY=
VITE_STRIPE_PRICE_PARTNER_SYNC_YEARLY=
VITE_STRIPE_PRICE_PREMIUM_POSITIONS_MONTHLY=
VITE_STRIPE_PRICE_PREMIUM_POSITIONS_YEARLY=
VITE_STRIPE_PRICE_WELLNESS_COACHING_MONTHLY=
VITE_STRIPE_PRICE_WELLNESS_COACHING_YEARLY=
VITE_STRIPE_PRICE_MEDICAL_EXPORT_MONTHLY=
VITE_STRIPE_PRICE_MEDICAL_EXPORT_YEARLY=
VITE_STRIPE_PRICE_ADVANCED_NSFW_DETECTION_MONTHLY=
VITE_STRIPE_PRICE_ADVANCED_NSFW_DETECTION_YEARLY=

# Edition-specific price IDs (SFW/NSFW, store/direct, monthly/yearly/lifetime)
VITE_STRIPE_SFW_APP_STORE_PRICE_ID=
VITE_STRIPE_SFW_APP_DIRECT_PRICE_ID=
VITE_STRIPE_SFW_PRO_STORE_MONTHLY_PRICE_ID=
VITE_STRIPE_SFW_PRO_STORE_YEARLY_PRICE_ID=
VITE_STRIPE_SFW_PRO_DIRECT_MONTHLY_PRICE_ID=
VITE_STRIPE_SFW_PRO_DIRECT_YEARLY_PRICE_ID=
VITE_STRIPE_SFW_PREMIUM_STORE_MONTHLY_PRICE_ID=
VITE_STRIPE_SFW_PREMIUM_STORE_YEARLY_PRICE_ID=
VITE_STRIPE_SFW_PREMIUM_DIRECT_MONTHLY_PRICE_ID=
VITE_STRIPE_SFW_PREMIUM_DIRECT_YEARLY_PRICE_ID=
VITE_STRIPE_SFW_LIFETIME_STORE_PRICE_ID=
VITE_STRIPE_SFW_LIFETIME_DIRECT_PRICE_ID=

VITE_STRIPE_NSFW_APP_DIRECT_PRICE_ID=
VITE_STRIPE_NSFW_PRO_DIRECT_MONTHLY_PRICE_ID=
VITE_STRIPE_NSFW_PRO_DIRECT_YEARLY_PRICE_ID=
VITE_STRIPE_NSFW_PREMIUM_DIRECT_MONTHLY_PRICE_ID=
VITE_STRIPE_NSFW_PREMIUM_DIRECT_YEARLY_PRICE_ID=
VITE_STRIPE_NSFW_LIFETIME_DIRECT_PRICE_ID=
VITE_STRIPE_NSFW_DLC_STORE_PRICE_ID=
VITE_STRIPE_NSFW_DLC_DIRECT_PRICE_ID=

##############################
# Observability              #
##############################

VITE_SENTRY_DSN=

##############################
# Email (client/public)      #
##############################

# WARNING: Anything in `VITE_*` is shipped to the browser.
# Prefer server-side email (Supabase functions + RESEND_API_KEY).
VITE_SMTP_HOST=
VITE_SMTP_PORT=
VITE_SMTP_SECURE=
VITE_SMTP_USER=
VITE_SMTP_PASS=

########################################
# Server-only / scripts (do not VITE_)  #
########################################

# Used by scripts/seed*, scripts/setup-storage-buckets.ts, etc.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Supabase CLI automation (optional)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# DB (server-only)
# Optional: used by `npm run db:types` when Docker isn't available.
# Provide a Postgres connection string that has access to `public` + `auth` schemas.
SUPABASE_DB_URL=
DATABASE_URL=

# Stripe (server-only; Supabase Edge Function secrets)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRO_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
APP_URL=http://localhost:8080

# Email (server-only; Supabase Edge Function secrets)
RESEND_API_KEY=
EMAIL_FROM="MorphoScan Pro <no-reply@yourdomain.invalid>"

# Data retention cleanup (server-only)
DATA_RETENTION_SECRET=CHANGE_ME

# Push notifications (server-only; Supabase Edge Function secrets)
FIREBASE_SERVICE_ACCOUNT=
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.morphoscan.pro
APNS_USE_SANDBOX=true

# AI providers (server-only; Supabase Edge Function secrets)
LOVABLE_API_KEY=
LOVABLE_AI_GATEWAY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_AI_API_KEY=
CUSTOM_AI_ENDPOINT=

# NSFW / Seductive AI (server-only; Supabase Edge Function secrets)
ALLOW_UNLICENSED_SEDUCTIVE_AI=false
SEDUCTIVE_AI_PROVIDER=
SEDUCTIVE_AI_ENDPOINT=
SEDUCTIVE_AI_MODEL=
SEDUCTIVE_AI_MODE=
SEDUCTIVE_AI_MAX_TOKENS=
SEDUCTIVE_AI_MAX_MESSAGE_CHARS=
SEDUCTIVE_AI_MEMORY_WINDOW=
SEDUCTIVE_AI_MEMORY_MAX=
SEDUCTIVE_AI_TOP_P=
SEDUCTIVE_AI_PRESENCE_PENALTY=
SEDUCTIVE_AI_FREQUENCY_PENALTY=
SEDUCTIVE_AI_RATE_LIMIT_MINUTE=
SEDUCTIVE_AI_RATE_LIMIT_HOUR=
SEDUCTIVE_AI_RATE_LIMIT_DAY=

# NSFW content delivery/storage (server-only)
NSFW_CONTENT_BUCKET=nsfw-content

# DLC keyring (server-only)
DLC_KEYRING_MASTER_KEY_B64=

# Test helpers (local only)
RLS_TEST_EMAIL=
RLS_TEST_PASSWORD=
PARTNER_SYNC_SEED_FILE=
ADMIN_SUPER_EMAIL=
