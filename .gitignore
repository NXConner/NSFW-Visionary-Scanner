# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
*.local

# Vite build output (generated)
dist/

# Test runner outputs
playwright-report/
test-results/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Android local configuration (contains machine-specific paths)
android/local.properties

# Android/Gradle generated caches and intermediates (do not commit)
# Keep final APK/AAB artifacts trackable via the allowlist below.
android/.gradle/
android/**/.gradle/
android/**/build/intermediates/
android/**/build/generated/
android/**/build/tmp/
android/**/build/kotlin/
android/**/build/reports/

# Android Gradle properties (base config tracked; secrets local)
android/gradle.properties.local
android/gradle.properties.user

# Local Android SDK (if installed in repo root)
android-sdk/

# Local archive workspace (manual review; never commit by default)
deleted files/*
!deleted files/src/
!deleted files/src/**

# Firebase config (do not commit; environment-specific)
android/app/google-services.json
ios/App/App/GoogleService-Info.plist

# Service account / APNs keys (never commit)
*firebase*service*account*.json
*.p8

# Keystore files (never commit to version control)
*.keystore
*.jks

# Environment files with secrets
.env
.env.local
.env.production.local
.env.development.local

# Build artifacts are intentionally tracked (APK distribution, assets, etc.)
!**/*.apk
!**/*.aab

# Gradle cache and build files are intentionally tracked

# Local comparison clones (do not commit)
external-repos/

# Supabase CLI temp files (never commit)
supabase/.temp/

# Core dumps (never commit)
/core
/core.*
*.core