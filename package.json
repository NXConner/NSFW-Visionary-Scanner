{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.9.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "cross-env NODE_ENV=production vite build",
    "build:dev": "vite build --mode development",
    "build:sfw": "cross-env VITE_APP_VERSION=sfw vite build",
    "build:nsfw": "cross-env VITE_APP_VERSION=nsfw vite build",
    "build:hybrid": "cross-env VITE_APP_VERSION=hybrid vite build",
    "build:sfw:store": "cross-env VITE_APP_VERSION=sfw VITE_DISTRIBUTION_CHANNEL=store vite build",
    "build:sfw:direct": "cross-env VITE_APP_VERSION=sfw VITE_DISTRIBUTION_CHANNEL=direct vite build",
    "build:nsfw:direct": "cross-env VITE_APP_VERSION=nsfw VITE_DISTRIBUTION_CHANNEL=direct vite build",
    "build:hybrid:store": "cross-env VITE_APP_VERSION=hybrid VITE_DISTRIBUTION_CHANNEL=store vite build",
    "build:hybrid:direct": "cross-env VITE_APP_VERSION=hybrid VITE_DISTRIBUTION_CHANNEL=direct vite build",
    "build:analyze": "vite build --mode production && npx vite-bundle-analyzer dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "preview": "vite preview",
    "prepare": "husky",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrate:local": "node scripts/db-migrate.mjs --mode=local",
    "db:migrate:remote": "node scripts/db-migrate.mjs --mode=remote",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --local > src/integrations/supabase/types.ts",
    "db:types:check": "node scripts/check-supabase-types.mjs",
    "db:types:remote:check": "node scripts/check-supabase-types-remote.mjs",
    "db:migrate:legacy": "node-pg-migrate -m supabase/migrations up",
    "db:rollback:legacy": "node-pg-migrate -m supabase/migrations down --steps 1",
    "db:create:legacy": "node-pg-migrate -m supabase/migrations create",
    "seed": "tsx scripts/seed.ts",
    "seed:partner-sync": "tsx scripts/seed-partner-sync.ts",
    "setup:storage": "tsx scripts/setup-storage-buckets.ts",
    "setup:complete": "powershell -ExecutionPolicy Bypass -File scripts/complete-setup.ps1",
    "deploy:functions": "powershell -ExecutionPolicy Bypass -File scripts/deploy-all.ps1",
    "scan:vuln": "npm audit --audit-level=high",
    "api:openapi": "node scripts/generate-openapi.mjs",
    "analyze:bundle": "node scripts/analyze-bundle.js",
    "perf:audit": "node scripts/performance-audit.js",
    "a11y:audit": "node scripts/accessibility-audit.js",
    "check:production": "node scripts/production-readiness-check.js",
    "check:pre-submission": "node scripts/pre-submission-checklist.js",
    "check:release-readiness": "node scripts/release-readiness-check.mjs",
    "perf:load": "k6 run -e BASE_URL=\"http://localhost:4173\" performance-tests/load-test.js",
    "perf:nsfw-media": "k6 run performance-tests/nsfw-media-load-test.js",
    "optimize:all": "npm run perf:audit && npm run a11y:audit && npm run analyze:bundle",
    "preflight:all": "npm run check:production && npm run check:pre-submission && npm run optimize:all",
    "verify:sfw:bundle": "node scripts/verify-sfw-bundle.mjs dist",
    "release:remote:ops": "node scripts/run-remote-release-ops.mjs",
    "release:secrets:provision": "node scripts/provision-release-secrets.mjs",
    "release:env:validate": "node scripts/validate-release-env.mjs",
    "release:remaining": "pwsh -File scripts/execute-release-remaining.ps1",
    "release:signoff": "pwsh -File scripts/release-signoff.ps1",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test:run && npm run test:e2e",
    "test:rls:partner-sync": "tsx scripts/rls-check-partner-sync.ts",
    "dlc:validate-import": "tsx scripts/validate-dlc-import.ts",
    "dlc:validate-catalog": "tsx scripts/validate-dlc-catalog.ts",
    "dlc:import-expert-content": "tsx scripts/import-education-expert-content.ts",
    "dlc:download-mit-positions": "tsx scripts/download-mit-positions-assets.ts",
    "dlc:build-mit-positions-csv": "tsx scripts/build-mit-positions-import.ts",
    "addons:validate-registry": "tsx scripts/validate-addon-registry.ts",
    "android:sync": "cross-env NODE_ENV=production CAPACITOR_BUILD=1 npx cap sync android",
    "android:build": "cd android && ./gradlew assembleRelease && cd ..",
    "android:build:full": "npm run build:capacitor && npm run android:sync && npm run android:build",
    "build:capacitor": "cross-env NODE_ENV=production CAPACITOR_BUILD=1 vite build",
    "verify:production": "powershell -ExecutionPolicy Bypass -File scripts/verify-production-readiness.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/camera": "^7.0.3",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/filesystem": "^7.1.5",
