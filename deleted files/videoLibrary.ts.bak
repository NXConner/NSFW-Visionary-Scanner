// Get videos with filters
export async function getVideos(
  category?: string, 
  featured?: boolean, 
  _premiumOnly?: boolean,
  _limit: number = 50
): Promise<Video[]> {
  return getSampleVideos(category, featured)
}

// Get single video by ID
export async function getVideo(videoId: string): Promise<Video | null> {
  const videos = getSampleVideos()
  return videos.find(v => v.id === videoId) || null
}

// Search videos
export async function searchVideos(query: string, _limit: number = 20): Promise<Video[]> {
  const videos = getSampleVideos()
  const lowerQuery = query.toLowerCase()
  return videos.filter(v =>
    v.title.toLowerCase().includes(lowerQuery) ||
    v.description?.toLowerCase().includes(lowerQuery) ||
    v.instructor_name?.toLowerCase().includes(lowerQuery) ||
    v.tags?.some(t => t.toLowerCase().includes(lowerQuery))
  )
}

// Update video progress
export async function updateVideoProgress(
  videoId: string, 
  progressSeconds: number, 
  durationSeconds?: number
): Promise<VideoProgress> {
  try {
    const { data: { user } } = await supabase.auth.getUser()
    const userId = user?.id || 'anonymous'

    const progressPercentage = durationSeconds 
      ? Math.min(100, (progressSeconds / durationSeconds) * 100)
      : 0
    const isCompleted = progressPercentage >= 90

    const allProgress = getLocalData<VideoProgress[]>(STORAGE_KEYS.PROGRESS, [])
    const existingIndex = allProgress.findIndex(p => p.user_id === userId && p.video_id === videoId)

    const progress: VideoProgress = {
      id: existingIndex >= 0 ? allProgress[existingIndex].id : crypto.randomUUID(),
      user_id: userId,
      video_id: videoId,
      progress_seconds: progressSeconds,
      progress_percentage: progressPercentage,
      is_completed: isCompleted,
      completed_at: isCompleted ? new Date().toISOString() : undefined,
      watch_count: (existingIndex >= 0 ? allProgress[existingIndex].watch_count || 0 : 0) + 1,
      last_watched_at: new Date().toISOString(),
      updated_at: new Date().toISOString(),
    }

    if (existingIndex >= 0) {
      allProgress[existingIndex] = progress
    } else {
      allProgress.push(progress)
    }

    setLocalData(STORAGE_KEYS.PROGRESS, allProgress)
    return progress
  } catch (err) {
    logger.error('Error updating video progress', { error: err })
    return { video_id: videoId, progress_seconds: progressSeconds }
  }
}

// Get user's video progress
export async function getUserVideoProgress(videoId?: string): Promise<VideoProgress[]> {
  try {
    const { data: { user } } = await supabase.auth.getUser()
    const userId = user?.id || 'anonymous'

    const allProgress = getLocalData<VideoProgress[]>(STORAGE_KEYS.PROGRESS, [])
    let filtered = allProgress.filter(p => p.user_id === userId)

    if (videoId) {
      filtered = filtered.filter(p => p.video_id === videoId)
    }

    return filtered.sort((a, b) => 
      new Date(b.last_watched_at || 0).getTime() - new Date(a.last_watched_at || 0).getTime()
    )
  } catch (err) {
    logger.error('Error getting video progress', { error: err })
    return []
  }
}

// Get continue watching list
export async function getContinueWatching(limit: number = 10): Promise<Video[]> {
  try {
    const progress = await getUserVideoProgress()
    const inProgress = progress
      .filter(p => !p.is_completed && (p.progress_percentage || 0) > 5)
      .slice(0, limit)

    const videos = getSampleVideos()
    return inProgress
      .map(p => videos.find(v => v.id === p.video_id))
      .filter(Boolean) as Video[]
  } catch (err) {
    logger.error('Error getting continue watching', { error: err })
    return []
  }
}

// Create playlist
export async function createPlaylist(
  playlist: Omit<VideoPlaylist, 'id' | 'user_id' | 'created_at' | 'updated_at' | 'video_count' | 'view_count'>
): Promise<VideoPlaylist> {
  try {
    const { data: { user } } = await supabase.auth.getUser()
    const userId = user?.id || 'anonymous'

    const newPlaylist: VideoPlaylist = {
      id: crypto.randomUUID(),
      user_id: userId,
      name: playlist.name,
      description: playlist.description,
      is_public: playlist.is_public || false,
      video_count: 0,
      view_count: 0,
      video_ids: [],
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString(),
    }

    const playlists = getLocalData<VideoPlaylist[]>(STORAGE_KEYS.PLAYLISTS, [])
    playlists.push(newPlaylist)
    setLocalData(STORAGE_KEYS.PLAYLISTS, playlists)

    toast.success('Playlist created')
    return newPlaylist
  } catch (err) {
    logger.error('Error creating playlist', { error: err })
    toast.error('Failed to create playlist')
    return { id: crypto.randomUUID(), name: playlist.name, ...playlist }
  }
}

// Get user's playlists
export async function getPlaylists(_userId?: string): Promise<VideoPlaylist[]> {
  try {
    const { data: { user } } = await supabase.auth.getUser()
    const userId = user?.id || 'anonymous'

    const playlists = getLocalData<VideoPlaylist[]>(STORAGE_KEYS.PLAYLISTS, [])
    return playlists.filter(p => p.user_id === userId || p.is_public)
  } catch (err) {
    logger.error('Error getting playlists', { error: err })
    return []
  }
}

// Add video to playlist
export async function addVideoToPlaylist(
  playlistId: string, 
  videoId: string, 
  _orderIndex?: number
): Promise<void> {
  try {
    const playlists = getLocalData<VideoPlaylist[]>(STORAGE_KEYS.PLAYLISTS, [])
    const playlist = playlists.find(p => p.id === playlistId)

    if (!playlist) {
      toast.error('Playlist not found')
      return
    }

    if (!playlist.video_ids) {
      playlist.video_ids = []
    }

    if (playlist.video_ids.includes(videoId)) {
      toast.info('Video already in playlist')
      return
    }

    playlist.video_ids.push(videoId)
    playlist.video_count = playlist.video_ids.length
    playlist.updated_at = new Date().toISOString()

    setLocalData(STORAGE_KEYS.PLAYLISTS, playlists)
    toast.success('Video added to playlist')
  } catch (err) {
    logger.error('Error adding video to playlist', { error: err })
    toast.error('Failed to add video')
  }
}

// Remove video from playlist
export async function removeVideoFromPlaylist(playlistId: string, videoId: string): Promise<void> {
  try {
    const playlists = getLocalData<VideoPlaylist[]>(STORAGE_KEYS.PLAYLISTS, [])
    const playlist = playlists.find(p => p.id === playlistId)

    if (!playlist || !playlist.video_ids) return

    playlist.video_ids = playlist.video_ids.filter(id => id !== videoId)
    playlist.video_count = playlist.video_ids.length
    playlist.updated_at = new Date().toISOString()

    setLocalData(STORAGE_KEYS.PLAYLISTS, playlists)
    toast.success('Video removed from playlist')
  } catch (err) {
    logger.error('Error removing video from playlist', { error: err })
  }
}

// Get videos in playlist
export async function getPlaylistVideos(playlistId: string): Promise<Video[]> {
  try {
    const playlists = getLocalData<VideoPlaylist[]>(STORAGE_KEYS.PLAYLISTS, [])
    const playlist = playlists.find(p => p.id === playlistId)

    if (!playlist || !playlist.video_ids) return []

    const videos = getSampleVideos()
    return playlist.video_ids
      .map(id => videos.find(v => v.id === id))
      .filter(Boolean) as Video[]
  } catch (err) {
    logger.error('Error getting playlist videos', { error: err })
    return []
  }
}

// Bookmark video
export async function bookmarkVideo(videoId: string, notes?: string): Promise<void> {
  try {
    const { data: { user } } = await supabase.auth.getUser()
    const userId = user?.id || 'anonymous'

    const bookmarks = getLocalData<VideoBookmark[]>(STORAGE_KEYS.BOOKMARKS, [])
    const existing = bookmarks.find(b => b.user_id === userId && b.video_id === videoId)

    if (existing) {
      existing.notes = notes
    } else {
      bookmarks.push({
        id: crypto.randomUUID(),
        user_id: userId,
        video_id: videoId,
        notes,
        created_at: new Date().toISOString(),
      })
    }

    setLocalData(STORAGE_KEYS.BOOKMARKS, bookmarks)
    toast.success('Video bookmarked')
  } catch (err) {
    logger.error('Error bookmarking video', { error: err })
    toast.error('Failed to bookmark video')
  }
}

// Remove bookmark
export async function removeBookmark(videoId: string): Promise<void> {
  try {
    const { data: { user } } = await supabase.auth.getUser()
    const userId = user?.id || 'anonymous'

    const bookmarks = getLocalData<VideoBookmark[]>(STORAGE_KEYS.BOOKMARKS, [])
    const filtered = bookmarks.filter(b => !(b.user_id === userId && b.video_id === videoId))

    setLocalData(STORAGE_KEYS.BOOKMARKS, filtered)
    toast.success('Bookmark removed')
  } catch (err) {
    logger.error('Error removing bookmark', { error: err })
  }
}

// Get bookmarked videos
export async function getBookmarkedVideos(): Promise<Video[]> {
  try {
    const { data: { user } } = await supabase.auth.getUser()
    const userId = user?.id || 'anonymous'

    const bookmarks = getLocalData<VideoBookmark[]>(STORAGE_KEYS.BOOKMARKS, [])
    const userBookmarks = bookmarks.filter(b => b.user_id === userId)

    const videos = getSampleVideos()
    return userBookmarks
      .map(b => videos.find(v => v.id === b.video_id))
      .filter(Boolean) as Video[]
  } catch (err) {
    logger.error('Error getting bookmarked videos', { error: err })
    return []
  }
}

// Check if video is bookmarked
export async function isVideoBookmarked(videoId: string): Promise<boolean> {
  try {
    const { data: { user } } = await supabase.auth.getUser()
    const userId = user?.id || 'anonymous'

    const bookmarks = getLocalData<VideoBookmark[]>(STORAGE_KEYS.BOOKMARKS, [])
    return bookmarks.some(b => b.user_id === userId && b.video_id === videoId)
  } catch {
    return false
  }
}

// Rate video
export async function rateVideo(videoId: string, rating: number, reviewText?: string): Promise<void> {
  try {
    const { data: { user } } = await supabase.auth.getUser()
    const userId = user?.id || 'anonymous'

    const ratings = getLocalData<VideoRating[]>(STORAGE_KEYS.RATINGS, [])
    const existingIndex = ratings.findIndex(r => r.user_id === userId && r.video_id === videoId)

    const ratingData: VideoRating = {
      id: existingIndex >= 0 ? ratings[existingIndex].id : crypto.randomUUID(),
      user_id: userId,
      video_id: videoId,
      rating,
      review_text: reviewText,
      created_at: existingIndex >= 0 ? ratings[existingIndex].created_at : new Date().toISOString(),
      updated_at: new Date().toISOString(),
    }

    if (existingIndex >= 0) {
      ratings[existingIndex] = ratingData
    } else {
      ratings.push(ratingData)
    }

    setLocalData(STORAGE_KEYS.RATINGS, ratings)
    toast.success('Rating saved')
  } catch (err) {
    logger.error('Error rating video', { error: err })
    toast.error('Failed to save rating')
  }
}

// Get video rating
export async function getVideoRating(videoId: string): Promise<VideoRating | null> {
  try {
    const { data: { user } } = await supabase.auth.getUser()
    const userId = user?.id || 'anonymous'

    const ratings = getLocalData<VideoRating[]>(STORAGE_KEYS.RATINGS, [])
    return ratings.find(r => r.user_id === userId && r.video_id === videoId) || null
  } catch {
    return null
  }
}

// Get all ratings for a video
export async function getVideoRatings(videoId: string): Promise<VideoRating[]> {
  const ratings = getLocalData<VideoRating[]>(STORAGE_KEYS.RATINGS, [])
  return ratings.filter(r => r.video_id === videoId)
}

// Download video (simulated)
export async function downloadVideo(videoId: string): Promise<VideoDownload | null> {
  try {
    const { data: { user } } = await supabase.auth.getUser()
    const userId = user?.id || 'anonymous'

    const download: VideoDownload = {
      id: crypto.randomUUID(),
      user_id: userId,
      video_id: videoId,
      download_status: 'completed',
      download_progress: 100,
      downloaded_at: new Date().toISOString(),
      expires_at: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString(),
      created_at: new Date().toISOString(),
    }

    const downloads = getLocalData<VideoDownload[]>(STORAGE_KEYS.DOWNLOADS, [])
    downloads.push(download)
    setLocalData(STORAGE_KEYS.DOWNLOADS, downloads)

    toast.success('Video downloaded')
    return download
  } catch (err) {
    logger.error('Error downloading video', { error: err })
    toast.error('Failed to download video')
    return null
  }
}

// Get downloaded videos
export async function getDownloadedVideos(): Promise<VideoDownload[]> {
  try {
    const { data: { user } } = await supabase.auth.getUser()
    const userId = user?.id || 'anonymous'

    const downloads = getLocalData<VideoDownload[]>(STORAGE_KEYS.DOWNLOADS, [])
    return downloads.filter(d => d.user_id === userId && d.download_status === 'completed')
  } catch {
    return []
  }
}

// Delete downloaded video
export async function deleteDownloadedVideo(downloadId: string): Promise<void> {
  try {
    const downloads = getLocalData<VideoDownload[]>(STORAGE_KEYS.DOWNLOADS, [])
    const filtered = downloads.filter(d => d.id !== downloadId)
    setLocalData(STORAGE_KEYS.DOWNLOADS, filtered)
    toast.success('Download deleted')
  } catch (err) {
    logger.error('Error deleting download', { error: err })
  }
}

// Get featured videos
export async function getFeaturedVideos(): Promise<Video[]> {
  return getSampleVideos(undefined, true)
}

// Get video categories
export async function getVideoCategories(): Promise<{ name: string; count: number }[]> {
  const videos = getSampleVideos()
  const categories: { [key: string]: number } = {}
  
  videos.forEach(v => {
    categories[v.category] = (categories[v.category] || 0) + 1
  })

  return Object.entries(categories).map(([name, count]) => ({ name, count }))
}

// Increment view count (local simulation)
export async function incrementViewCount(videoId: string): Promise<void> {
  // In local mode, this is a no-op since we use sample data
  logger.debug('View count incremented', { videoId })
}

// Get related videos
export async function getRelatedVideos(videoId: string, limit: number = 5): Promise<Video[]> {
  const video = await getVideo(videoId)
  if (!video) return []

  const videos = getSampleVideos()
  return videos
    .filter(v => v.id !== videoId && v.category === video.category)
    .slice(0, limit)
}

// Get trending videos
export async function getTrendingVideos(limit: number = 10): Promise<Video[]> {
  const videos = getSampleVideos()
  return videos
    .sort((a, b) => (b.view_count || 0) - (a.view_count || 0))
    .slice(0, limit)
}

// Get recently watched
export async function getRecentlyWatched(limit: number = 10): Promise<Video[]> {
  const progress = await getUserVideoProgress()
  const recent = progress.slice(0, limit)

  const videos = getSampleVideos()
  return recent
    .map(p => videos.find(v => v.id === p.video_id))
    .filter(Boolean) as Video[]
}
