// Helper to update enrollment progress after completing lessons
async function updateEnrollmentProgress(lessonId: string): Promise<void> {
  try {
    const { data: { user } } = await supabase.auth.getUser()
    if (!user) return

    // Get the lesson to find its module and course
    const { data: lesson } = await supabase
      .from('learning_lessons')
      .select('module_id')
      .eq('id', lessonId)
      .maybeSingle()

    if (!lesson) return

    const { data: module } = await supabase
      .from('learning_modules')
      .select('course_id')
      .eq('id', lesson.module_id)
      .maybeSingle()

    if (!module) return

    // Calculate progress
    const { data: allLessons } = await supabase
      .from('learning_lessons')
      .select('id')
      .in('module_id', 
        (await supabase
          .from('learning_modules')
          .select('id')
          .eq('course_id', module.course_id)
        ).data?.map(m => m.id) || []
      )

    const lessonIds = allLessons?.map(l => l.id) || []

    const { data: completedLessons } = await supabase
      .from('learning_lesson_progress')
      .select('id')
      .eq('user_id', user.id)
      .eq('is_completed', true)
      .in('lesson_id', lessonIds)

    const progress = lessonIds.length > 0 
      ? Math.round(((completedLessons?.length || 0) / lessonIds.length) * 100)
      : 0

    await supabase
      .from('learning_enrollments')
      .update({
        progress_percentage: progress,
        current_lesson_id: lessonId,
        last_accessed_at: new Date().toISOString(),
        ...(progress === 100 ? { completed_at: new Date().toISOString() } : {})
      })
      .eq('user_id', user.id)
      .eq('course_id', module.course_id)

    // Issue certificate if completed
    if (progress === 100) {
      await issueCertificate(module.course_id)
    }
  } catch (error) {
    logger.error('Failed to update enrollment progress', { error })
  }
}
