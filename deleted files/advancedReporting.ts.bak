// In-memory storage for reports (since DB tables don't exist yet)
const localReports: CustomReport[] = []

// Create custom report (local storage since no DB table)
export async function createCustomReport(
  reportName: string,
  reportType: CustomReport['report_type'],
  selectedMetrics: string[],
  dateRange: DateRange,
  config?: Partial<ReportConfig>,
  theme?: CustomReport['theme'],
  colorScheme?: ColorScheme
): Promise<CustomReport | null> {
  try {
    const defaultConfig: ReportConfig = {
      include_charts: true,
      include_tables: true,
      include_summary: true,
      include_recommendations: true,
      page_size: 'a4',
      orientation: 'portrait',
      ...config,
    }

    const defaultColorScheme: ColorScheme = colorScheme || {
      primary: '#3B82F6',
      secondary: '#10B981',
      accent: '#F59E0B',
      background: '#FFFFFF',
      text: '#1F2937',
    }

    const defaultChartTypes: ChartConfig = {
      progress_chart: 'line',
      comparison_chart: 'bar',
      distribution_chart: 'doughnut',
    }

    const report: CustomReport = {
      id: crypto.randomUUID(),
      user_id: 'local',
      report_name: reportName,
      description: null,
      report_type: reportType,
      report_config: defaultConfig,
      selected_metrics: selectedMetrics,
      date_range: dateRange,
      theme: theme || 'professional',
      color_scheme: defaultColorScheme,
      chart_types: defaultChartTypes,
      is_shared: false,
      share_token: null,
      shared_with_users: null,
      shared_with_doctors: null,
      is_scheduled: false,
      schedule_frequency: null,
      schedule_day: null,
      schedule_time: null,
      next_scheduled_at: null,
      last_generated_at: null,
      generation_count: 0,
      view_count: 0,
      share_count: 0,
      is_favorite: false,
      is_template: false,
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString(),
    }

    localReports.push(report)
    toast.success('Report created')
    return report
  } catch (err) {
    logger.error('Error creating report', { error: err })
    toast.error('Failed to create report')
    return null
  }
}

// Generate report PDF
export async function generateReport(reportId: string): Promise<string | null> {
  try {
    const report = localReports.find(r => r.id === reportId)
    
    if (!report) {
      // Generate a default report
      const doc = new jsPDF()
      doc.setFontSize(20)
      doc.text('Health Report', 20, 30)
      doc.setFontSize(12)
      doc.text('Generated on: ' + new Date().toLocaleDateString(), 20, 45)
      doc.text('This is a placeholder report.', 20, 60)
      
      const blob = doc.output('blob')
      const url = URL.createObjectURL(blob)
      toast.success('Report generated')
      return url
    }

    const doc = new jsPDF({
      orientation: report.report_config.orientation,
      unit: 'mm',
      format: report.report_config.page_size,
    })

    doc.setFontSize(20)
    doc.text(report.report_name, 20, 30)
    doc.setFontSize(12)
    doc.text('Generated on: ' + new Date().toLocaleDateString(), 20, 45)
    doc.text('Type: ' + report.report_type, 20, 55)
    
    const blob = doc.output('blob')
    const url = URL.createObjectURL(blob)
    
    report.generation_count++
    report.last_generated_at = new Date().toISOString()
    
    toast.success('Report generated')
    return url
  } catch (err) {
    logger.error('Error generating report', { error: err })
    toast.error('Failed to generate report')
    return null
  }
}

// Schedule report
export async function scheduleReport(
  reportId: string,
  frequency: 'daily' | 'weekly' | 'monthly',
  day?: number,
  time?: string
): Promise<boolean> {
  try {
    const report = localReports.find(r => r.id === reportId)
    if (!report) {
      toast.error('Report not found')
      return false
    }

    report.is_scheduled = true
    report.schedule_frequency = frequency
    report.schedule_day = day || null
    report.schedule_time = time || null
    report.next_scheduled_at = calculateNextScheduledDate(frequency, day, time)
    report.updated_at = new Date().toISOString()

    toast.success('Report scheduled')
    return true
  } catch (err) {
    logger.error('Error scheduling report', { error: err })
    return false
  }
}

// Get custom reports
export async function getCustomReports(favoritesOnly?: boolean): Promise<CustomReport[]> {
  if (favoritesOnly) {
    return localReports.filter(r => r.is_favorite)
  }
  return [...localReports]
}

