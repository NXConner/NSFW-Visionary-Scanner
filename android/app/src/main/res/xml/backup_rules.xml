<?xml version="1.0" encoding="utf-8"?>
<!--
    Android Backup Rules - Security Hardened
    Excludes sensitive data from cloud backups
-->
<full-backup-content>
    <!-- Include general app data -->
    <include domain="sharedpref" path="." />
    <include domain="database" path="." />
    <include domain="file" path="." />
    
    <!-- Exclude sensitive data from backups -->
    <exclude domain="sharedpref" path="auth_tokens.xml" />
    <exclude domain="sharedpref" path="secure_storage.xml" />
    <exclude domain="sharedpref" path="device_id.xml" />
    <exclude domain="sharedpref" path="license_data.xml" />
    <exclude domain="database" path="secure_*.db" />
    <exclude domain="file" path="cache/" />
    <exclude domain="file" path="no_backup/" />
</full-backup-content>

