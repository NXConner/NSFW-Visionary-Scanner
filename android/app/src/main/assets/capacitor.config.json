{
	"appId": "com.morphoscan.pro",
	"appName": "MorphoScan Pro",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"cleartext": false
	},
	"android": {
		"allowMixedContent": false,
		"captureInput": true,
		"webContentsDebuggingEnabled": true,
		"backgroundColor": "#0a0a0a"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2000,
			"backgroundColor": "#0a0a0a",
			"androidScaleType": "CENTER_CROP",
			"showSpinner": false
		}
	}
}
